{
  "name": "memos-sync",
  "version": "1.0.1",
  "description": "Sync new and edited memos from Memos to Obsidian daily notes",
  "main": "main.js",
  "scripts": {
    "test": "node --test tests/memos-sync.test.cjs",
    "typecheck": "tsc --noEmit",
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "deploy": "node esbuild.config.mjs production && cp main.js manifest.json \"$OBSIDIAN_PLUGIN_DIR\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.21.0",
    "obsidian": "^1.5.12",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "obsidian-daily-notes-interface": "^0.9.4"
  }
}
